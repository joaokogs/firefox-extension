{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "16.1.2",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "author": "João Pedro Koguishi",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "bookmarks",
    "identity",
    "search"
  ],
  "host_permissions": [
    "*://api.open-meteo.com/*",
    "*://geocoding-api.open-meteo.com/*",
    "*://api.bigdatacloud.net/*",
    "https://*.supabase.co/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "__MSG_defaultTitle__"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "luma-dashboard@luma-extension.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: wss:;"
  }
}
